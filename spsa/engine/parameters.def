// PARAM(identifier, default, minimum, maximum, scale, group, description)
// Integer wire units. Real coefficient = wire value / scale.
PARAM(AspirationDepth, 3, 1, 8, 1, search, "Full-window search through this depth")
PARAM(AspirationDelta, 15, 8, 100, 1, search, "Initial aspiration half-window")
PARAM(AspirationGrowthDivisor, 2, 1, 8, 1, search, "Integer divisor for aspiration window growth")
PARAM(AspirationFallback, 1000, 100, 3000, 1, search, "Window size triggering full-window fallback")
PARAM(IIRDepth, 4, 4, 10, 1, search, "Minimum depth for internal iterative reduction")
PARAM(IIRReduction, 1, 1, 3, 1, search, "Internal iterative reduction without a TT move")
PARAM(RFPDepth, 5, 1, 8, 1, search, "Maximum reverse futility depth; also gates forward futility")
PARAM(RFPMargin, 120, 30, 300, 1, search, "Reverse futility margin per depth")
PARAM(FutilityDepth, 3, 1, 3, 1, search, "Forward futility depth, bounded by margin table")
PARAM(FutilityMargin1, 200, 50, 450, 1, search, "Forward futility margin at depth one")
PARAM(FutilityMargin2, 300, 100, 650, 1, search, "Forward futility margin at depth two")
PARAM(FutilityMargin3, 450, 150, 900, 1, search, "Forward futility margin at depth three")
PARAM(NullMinDepth, 3, 2, 8, 1, search, "Minimum null-move depth")
PARAM(NullEvalDivisor, 200, 50, 500, 1, search, "Null-move evaluation surplus divisor")
PARAM(NullEvalCap, 2, 0, 4, 1, search, "Maximum extra null-move reduction")
PARAM(NullBase, 3, 1, 6, 1, search, "Base null-move reduction")
PARAM(NullDepthDivisor, 4, 2, 8, 1, search, "Null-move depth divisor")
PARAM(CheckExtension, 1, 0, 1, 1, search, "Check extension in plies")
PARAM(LMPDepth, 4, 1, 8, 1, search, "Maximum late move pruning depth")
PARAM(LMPBase, 3, 1, 12, 1, search, "Constant term of late move pruning threshold")
PARAM(LMPQuadratic, 4, 1, 12, 1, search, "Quadratic late move pruning coefficient")
PARAM(LMRBase, 75, 0, 200, 100, search, "Logarithmic reduction table intercept")
PARAM(LMRDivisor, 225, 100, 500, 100, search, "Logarithmic reduction table divisor")
PARAM(LMRDepth, 3, 2, 8, 1, search, "Minimum late move reduction depth")
PARAM(LMRMoves, 3, 1, 12, 1, search, "Number of moves before reductions begin")
PARAM(LMRKillerAdjustment, 1, 0, 3, 1, search, "Reduction discount for killer or countermove")
PARAM(LMRPVAdjustment, 1, 0, 3, 1, search, "Reduction discount in PV nodes")
PARAM(LMRHistoryDivisor, 4096, 1024, 16384, 1, search, "History score divisor for reduction adjustment")
PARAM(HistoryMax, 16384, 4096, 32768, 1, search, "History gravity limit, greater than bonus cap")
PARAM(HistoryBonusCap, 400, 50, 1000, 1, search, "Maximum depth-squared history bonus")
PARAM(QDeltaMargin, 200, 20, 500, 1, search, "Quiescence delta pruning margin")
PARAM(MVVAttackerDivisor, 100, 25, 400, 1, search, "Attacker value divisor inside MVV-LVA capture ordering")
PARAM(PawnValue, 100, 50, 200, 1, pieces, "Pawn search material value")
PARAM(KnightValue, 429, 250, 650, 1, pieces, "Knight search material value")
PARAM(BishopValue, 439, 250, 650, 1, pieces, "Bishop search material value")
PARAM(RookValue, 685, 450, 1000, 1, pieces, "Rook search material value")
PARAM(QueenValue, 1368, 1000, 2000, 1, pieces, "Queen search material value")
PARAM(MoveOverhead, 10, 0, 100, 1, time, "Milliseconds reserved before time allocation")
PARAM(MovesRemainingCap, 50, 10, 80, 1, time, "Cap on supplied moves to go")
PARAM(MovesRemainingDefault, 40, 10, 80, 1, time, "Estimated moves remaining with sudden death")
PARAM(TimeIncrement, 75, 0, 100, 100, time, "Increment contribution to both time budgets")
PARAM(TimeMaximumFactor, 500, 100, 1000, 100, time, "Base allocation multiplier for hard budget")
PARAM(TimeOptimumCap, 50, 5, 80, 100, time, "Fraction of clock allowed for soft budget")
PARAM(TimeMaximumCap, 80, 20, 95, 100, time, "Fraction of clock allowed for hard budget")
PARAM(TimeInstabilityCap, 200, 100, 400, 100, time, "Maximum soft-budget instability multiplier")
PARAM(TimeInstabilityFactor, 150, 100, 250, 100, time, "Multiplier when the best move changes")
PARAM(TimeInstabilityDepth, 4, 1, 10, 1, time, "Completed depth before best-move instability extends time")
